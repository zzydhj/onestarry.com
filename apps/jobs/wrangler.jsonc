{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "onestarry-jobs",
    "main": "index.ts",
    "compatibility_date": "2026-01-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "vars": {
        "RELAY_BATCH_LIMIT": "500",
        "ISR_PROBE_SLUGS": "3"
    },
    "hyperdrive": [
        {
            "binding": "HYPERDRIVE",
            "id": "797e790ce60448298d7a5502a6ea15fb",
            "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
        }
    ],
    "r2_buckets": [
        {
            // 前台 ISR 成品页桶：探针结论写 _ops/，并清理历史 buildId 遗留条目
            "binding": "ISR_CACHE",
            "bucket_name": "onestarry-isr-cache"
        }
    ],
    "triggers": {
        "crons": [
            "* * * * *",
            "*/5 * * * *",
            "20 4 * * *"
        ]
    }
}