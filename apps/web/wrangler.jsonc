{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "onestarry-com",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-01-01",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "hyperdrive": [
        {
            "binding": "HYPERDRIVE",
            "id": "797e790ce60448298d7a5502a6ea15fb"
        }
    ],
    "r2_buckets": [
        {
            "binding": "MEDIA",
            "bucket_name": "onestarry-media"
        }
    ]
}