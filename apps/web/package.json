{
    "name": "@onestarry/web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
        "preview": "pnpm cf:build && opennextjs-cloudflare preview",
        "deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "next": "^15.5.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "@onestarry/db": "workspace:*",
        "@onestarry/auth": "workspace:*",
        "@onestarry/core": "workspace:*",
        "@onestarry/ui": "workspace:*",
        "@opennextjs/cloudflare": "^1.5.3",
        "drizzle-orm": "^0.45.2",
        "postgres": "^3.4.5"
    },
    "devDependencies": {
        "@onestarry/config": "workspace:*",
        "@tailwindcss/postcss": "^4.0.0",
        "tailwindcss": "^4.0.0",
        "wrangler": "^4.28.1",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "typescript": "^5.7.2"
    }
}