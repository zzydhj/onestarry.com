# apps/admin/.dev.vars —— 本地模拟 Workers 环境用（opennextjs-cloudflare preview / wrangler dev）
# 日常 `pnpm dev` 走 next dev 读仓库根 .env.local，不需要本文件。
# 用法：cp .dev.vars.example .dev.vars
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://neondb_owner:CHANGE_ME@ep-CHANGE_ME.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B
