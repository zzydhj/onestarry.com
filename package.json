{
    "name": "onestarry-ecommerce-template",
    "private": true,
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=20.9"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "scan:dead": "node scripts/dead-scan.mjs",
        "deps:window": "pnpm --filter @onestarry/core deps:window",
        "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
        "db:generate": "pnpm --filter @onestarry/db db:generate",
        "db:migrate": "pnpm --filter @onestarry/db db:migrate",
        "db:partition": "pnpm --filter @onestarry/db db:partition",
        "db:studio": "pnpm --filter @onestarry/db db:studio",
        "seed:all": "pnpm --filter @onestarry/db seed:ledger && pnpm --filter @onestarry/db seed:catalog && pnpm --filter @onestarry/db seed:demo && pnpm --filter @onestarry/admin seed:admin"
    },
    "devDependencies": {
        "turbo": "^2.3.3",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "@neon/config": "^1.9.2",
        "@neon/env": "^1.6.3"
    }
}