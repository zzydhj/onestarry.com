# ─────────────────────────────────────────────────────────────
# onestarry 本地开发环境变量样板（Next dev / 迁移 / seed / smoke / Drizzle Studio 都读这里）
# 用法：cp .env.example .env.local  然后按注释逐项填。
# ⚠️ .env.local 已在 .gitignore 内；生产 secret 走 Cloudflare Workers Builds Secrets（见 README）。
# ─────────────────────────────────────────────────────────────

# ── 数据库（Neon） ───────────────────────────────────────────
# 直连端点（host 不含 -pooler），迁移 / seed / smoke / db:partition 用
# Neon Console → 项目 → Connection Details → "Direct connect"
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:CHANGE_ME@ep-CHANGE_ME.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# 池化端点（host 含 -pooler），本地 next dev 与构建期 ISR 预渲染用
# ⚠️ Workers Builds 中作为 secret 注入时值不要带引号（血泪：带引号 → 28P01 认证失败）
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-CHANGE_ME-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Better Auth 密钥 ─────────────────────────────────────────
# 32 字节 base64：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 本地开发：web/admin 共用一个即可；生产分别设独立 Workers secret（可同值可不同值）
BETTER_AUTH_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B

# ── seed:admin 用（不参与运行时，不会写进 Workers secret） ──
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe_Strong1
SEED_BETTER_AUTH_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B

# ── 角色分离后可选：应用低权角色连接串（app_rw） ───────────
# 若你已跑 packages/db/drizzle/manual/0015_app_role.sql 并把 Hyperdrive 切到 app_rw，
# 可把上面的 DATABASE_URL 用户段改成 app_rw；DDL 相关的 DATABASE_URL_UNPOOLED 保持 neondb_owner。

# ── 前台按需失效共享密钥（admin → web）─────────────────────────
# 同一个值要同时存在于 web 与 admin 两个 Worker：
#   生产：Workers secret INVALIDATE_SECRET（两边同值）；本地：两份 .dev.vars 各一份。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 缺失不会报错：后台保存照旧成功，前台退回各页自己的 revalidate 定时器（商品页 60s、法律页 60s）追平。
INVALIDATE_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B

# ── 外部集成接口共享密钥（/integration/{stock/demand/inventory}）───────
# apps/web 的三个 /integration/* 端点靠它做 fail-closed 鉴权：写接口需带请求头 `X-Integration-Key` 且等于此值。
#   生产：web Worker 的 secret（`wrangler secret put INTEGRATION_SECRET`）；本地：`apps/web/.dev.vars`。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 未配置 → 三个端点一律 503（fail-closed：宁可拒服务也不放行）。审查 M-5：新同学照本样板漏填会把它当成 bug 排查，故在此显式列出。
INTEGRATION_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B

# ── 假支付回调开关（仅本地/dev）───────────────────────────
# /api/webhooks/[provider] 默认 **不收** 任何回调：真 PSP 未接入前，FakePaymentProvider 不验签，
# 把它当默认值就等于在公网上开“把任意订单标成已付”的入口（2026-10-23 代码审查 P1-4）。
# 要跑假回调（本地验证落账链路）才改成 1；**生产不要设这个变量**（例子这里给 0，与生产同口径）。
# 接了 Stripe/PayPal 后本行作废，换成各 PSP 自己的密钥。
FAKE_PAYMENTS_ENABLED=0

# ── PayPal 自行集成（Advanced Control / Orders v2）───────────────
# 不配也能跑：缺凭据时支付页会说“PayPal 未配置”，webhook 依旧 fail-closed（不会默默收假消息）。
# 拿值：PayPal Developer Dashboard → Apps & Credentials → Create App（Live 或 Sandbox）→ REST API credentials。
#   PAYPAL_CLIENT_ID  会出现在浏览器（SDK 要用），它不是 secret；本地/dev 用 **Sandbox** 那组值。
#   PAYPAL_SECRET     只给服务端，**永远不要**拼到前端或写进仓库。
#   PAYPAL_ENV        sandbox | live；缺省或写错一律当 sandbox，不会意外打到生产。
#   PAYPAL_WEBHOOK_ID 后台给 https://onestarry.com/api/webhooks/paypal 建订阅后那个 **WH- 开头的订阅 id**（不是事件 id）；
#                     不填则回调一律拒收（验不了签的就不该信）。
#   PAYPAL_ALLOW_SANDBOX 沙箱凭据能不能动账。**缺省 0 = 不能**：
#                     沙箱里走完一笔“真流程”，服务端三道闸全过（单是自己建的、单号与金额都对），但它一分钱没付；
#                     拿沙箱凭据挂在线上就能把客户真单标成已付并发货。本地 dev 在 apps/web/.dev.vars 里给 1；
#                     要在线上拿沙箱端到端测就临时 `wrangler secret put PAYPAL_ALLOW_SANDBOX` 填 1，**测完立刻删掉**。
# 生产下这五项是 Workers 变量/secret（wrangler secret put PAYPAL_SECRET 等），不是本文件。
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# 沙箱凭据动账的显式开关；线上留 0（本地 dev 靠 apps/web/.dev.vars 覆盖成 1）
PAYPAL_ALLOW_SANDBOX=0
