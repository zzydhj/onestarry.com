# ─────────────────────────────────────────────────────────────
# onestarry 本地开发环境变量样板（Next dev / 迁移 / seed / smoke / Drizzle Studio 都读这里）
# 用法：cp .env.example .env.local  然后按注释逐项填。
# ⚠️ .env.local 已在 .gitignore 内；生产 secret 走 Cloudflare Workers Builds Secrets（见 README）。
# ─────────────────────────────────────────────────────────────

# ── 数据库（Neon） ───────────────────────────────────────────
# 直连端点（host 不含 -pooler），迁移 / seed / smoke / db:partition 用
# Neon Console → 项目 → Connection Details → "Direct connect"
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:CHANGE_ME@ep-CHANGE_ME.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# 池化端点（host 含 -pooler），本地 next dev 与构建期 ISR 预渲染用
# ⚠️ Workers Builds 中作为 secret 注入时值不要带引号（血泪：带引号 → 28P01 认证失败）
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-CHANGE_ME-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Better Auth 密钥 ─────────────────────────────────────────
# 32 字节 base64：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 本地开发：web/admin 共用一个即可；生产分别设独立 Workers secret（可同值可不同值）
BETTER_AUTH_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B

# ── seed:admin 用（不参与运行时，不会写进 Workers secret） ──
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe_Strong1
SEED_BETTER_AUTH_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B

# ── 角色分离后可选：应用低权角色连接串（app_rw） ───────────
# 若你已跑 packages/db/drizzle/manual/0015_app_role.sql 并把 Hyperdrive 切到 app_rw，
# 可把上面的 DATABASE_URL 用户段改成 app_rw；DDL 相关的 DATABASE_URL_UNPOOLED 保持 neondb_owner。

# ── 前台按需失效共享密钥（admin → web）─────────────────────────
# 同一个值要同时存在于 web 与 admin 两个 Worker：
#   生产：Workers secret INVALIDATE_SECRET（两边同值）；本地：两份 .dev.vars 各一份。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 缺失不会报错：后台保存照旧成功，前台退回各页自己的 revalidate 定时器（商品页 60s、法律页 3600s）追平。
INVALIDATE_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_BASE64_32B
